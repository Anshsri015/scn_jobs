# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
pubspec.lock.bak

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit signing or environment secrets
android/key.properties
*.jks
*.keystore
.env
.env.*

# Generated code we do NOT commit (freezed/json_serializable ARE committed
# per Section 2.9 of the plan — this only excludes build-cache artifacts)
.dart_tool/build/

# Logs written by AppLogger in debug builds
logs/

# WHY THIS FILE
# Keeps build artifacts, IDE noise, and — critically — signing keys and
# .env secrets out of version control from commit 1, before there's ever
# a chance to accidentally commit android/key.properties or a keystore.
# Alternative considered: adding secret-exclusion rules only on Day 36
# when signing is set up. Rejected — that's exactly the day a real key
# exists and a one-day gap is enough to leak it.
# Pitfall a junior would hit: committing pubspec.lock's "build" folder or
# an accidentally-generated .jks file before this file exists.
